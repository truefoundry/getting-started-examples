# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_API_PREFIX=

# Set true for local smoke tests without a TrueFoundry API key
LOCAL_FAKE_LLM=true

# TrueFoundry LLM Gateway (required when LOCAL_FAKE_LLM=false)
TFY_API_KEY=
TFY_LLM_GATEWAY_BASE_URL=https://<your-org>.truefoundry.cloud/api/llm/api/inference/openai
LLM_MODEL=openai-main/gpt-4o-mini
EMBEDDING_MODEL=openai-main/text-embedding-3-small
# Must match embedding model output size (text-embedding-3-small default = 1536)
EMBEDDING_DIMENSIONS=1536

# Optional FastAPI root path (set automatically on TrueFoundry)
TFY_SERVICE_ROOT_PATH=

# RAG tuning
COLLECTION_NAME=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
SIMILARITY_TOP_K=5
FAKE_EMBEDDING_SIZE=384

# Deploy script (deploy/deploy.py)
WORKSPACE_FQN=<your-cluster>:<your-workspace>
RAG_IMAGE=<registry>/rag-app:latest
HELM_REPO_URL=https://github.com/truefoundry/getting-started-examples
HELM_REVISION=chintan-rag-onboarding-with-helm
HELM_RAG_CHART_PATH=rag-onboarding-with-helm/charts/rag-app
RAG_RELEASE_NAME=rag-app

# Official Qdrant Helm chart (Bitnami does not publish Qdrant)
QDRANT_RELEASE_NAME=qdrant
QDRANT_HELM_REPO_URL=https://qdrant.github.io/qdrant-helm
QDRANT_HELM_CHART=qdrant
QDRANT_HELM_CHART_VERSION=1.18.2
QDRANT_PERSISTENCE_SIZE=10Gi
